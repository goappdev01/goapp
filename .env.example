SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_KEY
PORT=5000
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:5000/api

# GO IA / reservas: solo servidor. Nunca usar EXPO_PUBLIC_ para estas variables.
# Sin clave: se conserva el flujo escrito con extracción local.
OPENAI_API_KEY=
GO_ASSISTANT_MODEL=gpt-4o-mini
GO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Instancia Photon para resolver destinos y direcciones; no consulta disponibilidad.
GO_GEOCODER_URL=https://photon.komoot.io/api/
