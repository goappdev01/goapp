FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@10.17.1
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN node artifacts/api-server/build.mjs

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-spa tesseract-ocr-eng tesseract-ocr-osd poppler-utils \
    && rm -rf /var/lib/apt/lists/*
RUN tesseract --list-langs 2>&1 | grep -q spa && tesseract --version >/dev/null 2>&1 \
    && pdftotext -v >/dev/null 2>&1 && pdfinfo -v >/dev/null 2>&1 && pdftoppm -v >/dev/null 2>&1
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=build --chown=node:node /app/artifacts/api-server/dist ./dist
USER node
EXPOSE 8080
CMD ["node", "--enable-source-maps", "dist/index.mjs"]
