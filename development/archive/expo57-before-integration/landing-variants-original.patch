+  {
+    key: "profesional",
+    label: "Profesional",
+    description: "Tierra tenue, superficies sobrias y acentos contenidos",
+    colors: ["#101B2C", "#263B50", "#BAA46D"],
+  },
+  {
+    key: "confianza",
