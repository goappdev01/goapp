+export const LANDING_VISUAL_VARIANTS: ReadonlyArray<{
+  key: LandingVisualVariant;
+  label: string;
+  description: string;
+  colors: readonly [string, string, string];
+}> = [
+  {
+    key: "actual",
+    label: "Actual",
+    description: "Control · aspecto original de GO",
+    colors: ["#0B1120", "#D4AA3F", "#427ACC"],
